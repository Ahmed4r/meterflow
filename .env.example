# Copy to .env. Generate unique secrets; never commit .env.
DATABASE_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
# Local HTTP only. Must be true behind HTTPS in deployment.
SECURE_COOKIE=false
DEMO_SEED=true
DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-characters
RETENTION_DAYS=400
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
